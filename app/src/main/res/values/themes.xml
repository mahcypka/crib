<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Фон окна задан здесь только как запасной вариант на самый холодный старт,
        до чтения сохранения. Дальше цвет подставляется в коде из правил партии:
        MainActivity.applySystemColors ставит window.setBackgroundDrawable и цвета
        системных панелей, а Theme.palette(TableStyle) держит тот же набор для Canvas.
        Менять эти два места по отдельности нельзя — разъедутся.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF14532D</item>
        <item name="android:colorBackground">#FF14532D</item>
        <item name="android:statusBarColor">#FF0B3A1C</item>
        <item name="android:navigationBarColor">#FF0B3A1C</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorAccent">#FF7FD89A</item>
        <item name="android:textColorPrimary">#FFF2F2EF</item>
    </style>
</resources>
